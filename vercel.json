{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.theplatinumexteriors.com" }],
      "destination": "https://theplatinumexteriors.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.theplatinumexteriors.com" }],
      "destination": "https://theplatinumexteriors.com/:path*",
      "permanent": true
    }
  ]
}
